<?xml version="1.0" encoding="utf-8"?>
<!-- Superuser section -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/superUserLinearLayout">

    <TextView
        android:id="@+id/textView"
        android:text="@string/superuser_settings_description"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:paddingTop="6dip"
        android:paddingBottom="6dip"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <RadioGroup
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="right">

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/superuser_never"
            android:id="@+id/neverRadioButton"
            android:checked="false"
            android:paddingRight="15dp" />

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/superuser_always"
            android:id="@+id/alwaysRadioButton"
            android:layout_gravity="center_horizontal"
            android:checked="false"
            android:paddingRight="15dp" />

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/superuser_ask"
            android:id="@+id/askRadioButton"
            android:layout_gravity="center_horizontal"
            android:checked="false"
            android:paddingRight="15dp" />
    </RadioGroup>
</LinearLayout>
